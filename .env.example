VITE_APP_DATA_SOURCE=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-key

# Local seed data is a backup mode only. Enable it intentionally with:
# VITE_APP_DATA_SOURCE=local

# Optional local Apple development team for npm run ios:refresh:devices.
# Set this in .env.local on the Mac that signs the paired iPhone build.
IOS_REFRESH_DEVELOPMENT_TEAM=
